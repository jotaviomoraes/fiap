# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore e nunca deve ser commitado.

# Fase 2 — API OpenWeather (previsão de chuva)
OPENWEATHER_API_KEY=sua_api_key_aqui

# Fases 2 e 3 — Banco Oracle FIAP
ORACLE_USER=seu_rm_aqui
ORACLE_PASSWORD=sua_senha_aqui
ORACLE_DSN=oracle.fiap.com.br:1521/orcl

# Fase 7 — Alertas AWS (tópico SNS)
# As credenciais da AWS ficam no arquivo local da AWS, nunca neste .env.
AWS_DEFAULT_REGION=us-east-1
FARMTECH_SNS_TOPIC_ARN=
