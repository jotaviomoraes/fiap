# =====================================================================
# Sompo AgroPredict - variaveis de ambiente
# ---------------------------------------------------------------------
# Copie este arquivo para `config/.env` e preencha com as SUAS
# credenciais. O arquivo `config/.env` esta no .gitignore e NUNCA deve
# ser versionado.
#
# PowerShell (Windows):
#     $env:APP_USERNAME="admin"
#     $env:APP_PASSWORD="use-uma-senha-forte"
#     $env:ORACLE_USER="seu_usuario"
#     $env:ORACLE_PASSWORD="sua_senha"
#     $env:ORACLE_DSN="localhost:1521/XE"
#
# Bash (Linux/macOS):
#     export APP_USERNAME="admin"
#     export APP_PASSWORD="use-uma-senha-forte"
#     export ORACLE_USER="seu_usuario"
#     export ORACLE_PASSWORD="sua_senha"
#     export ORACLE_DSN="localhost:1521/XE"
# =====================================================================

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/XE
# Usuario inicial do dashboard (opcional). Na inicializacao ele e criado
# no SQLite com senha em hash PBKDF2 (minimo 8 caracteres) e o perfil de
# APP_PERFIL: operador, gestor, tecnico, analista ou admin (padrao admin).
# Os demais usuarios sao criados com scripts/gerenciar_usuarios.py.
APP_USERNAME=admin
APP_PASSWORD=troque-por-uma-senha-forte
APP_PERFIL=admin
# Local do banco SQLite e do log da aplicacao (padrao: <raiz>/data)
# AGROPREDICT_DATA_DIR=
