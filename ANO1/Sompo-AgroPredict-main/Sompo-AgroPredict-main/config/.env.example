# =====================================================================
# AgroPredict - variáveis de ambiente
# ---------------------------------------------------------------------
# Copie este arquivo para `config/.env` e preencha com as SUAS
# credenciais. O arquivo `config/.env` está no .gitignore e NUNCA deve
# ser versionado.
#
# O Oracle Autonomous Database é o banco principal. O SQLite é usado
# automaticamente quando o Oracle não está configurado ou acessível.
# =====================================================================

# auto (padrão) = tenta Oracle e cai para SQLite | oracle = exige Oracle | sqlite = só local
DB_BACKEND=auto

# --- Oracle Autonomous Database (modo Thin, sem Instant Client) ------
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
# Alias do tnsnames.ora da wallet (ex.: joaopersonal_tp)
ORACLE_DSN=joaopersonal_tp
# Pasta que contém ewallet.pem + tnsnames.ora (caminho absoluto)
ORACLE_CONFIG_DIR=C:\Users\seu_usuario\Documents\wallet Oracle
# Normalmente a mesma pasta da wallet; pode ficar em branco
ORACLE_WALLET_LOCATION=C:\Users\seu_usuario\Documents\wallet Oracle
# Só preencha se a wallet tiver senha
# ORACLE_WALLET_PASSWORD=

# --- Usuário inicial do dashboard (opcional) -------------------------
# Criado na primeira inicialização com senha em hash PBKDF2 (mínimo 8
# caracteres) e o perfil de APP_PERFIL: operador, gestor, tecnico,
# analista ou admin (padrão admin).
APP_USERNAME=admin
APP_PASSWORD=troque-por-uma-senha-forte
APP_PERFIL=admin

# --- Dashboard -------------------------------------------------------
# Idioma inicial: pt, en ou es (também pode ser trocado na tela)
APP_LANG=pt
# Popula a demonstração automaticamente em banco vazio (false desativa)
APP_DEMO=true

# --- Caminhos locais (opcional) --------------------------------------
# Local do banco SQLite de fallback e do log (padrão: <raiz>/data)
# AGROPREDICT_DATA_DIR=
# AGROPREDICT_DB=
